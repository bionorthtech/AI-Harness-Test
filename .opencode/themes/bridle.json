{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#0B0B0D",
    "darkSurface": "#141417",
    "darkElement": "#1C1C20",
    "darkBorderSubtle": "#242430",
    "darkBorder": "#3A3A43",
    "darkBorderActive": "#4C4C57",
    "darkFaint": "#6B6B74",
    "darkTextMuted": "#8B8B95",
    "darkText": "#E8E8EC",
    "darkSteel": "#6BA0CE",
    "darkSteelStrong": "#8FBBE0",
    "darkSteelDeep": "#4E7EA8",
    "darkSuccess": "#7FA96C",
    "darkWarning": "#D9A441",
    "darkDanger": "#C8583F",

    "lightBg": "#F3F3F5",
    "lightSurface": "#FAFAFC",
    "lightElement": "#FFFFFF",
    "lightBorderSubtle": "#E9E9EE",
    "lightBorder": "#CDCDD5",
    "lightBorderActive": "#B4B4BF",
    "lightFaint": "#83838D",
    "lightTextMuted": "#5F5F69",
    "lightText": "#17171B",
    "lightSteel": "#33628F",
    "lightSteelStrong": "#274E73",
    "lightSteelDeep": "#4E7EA8",
    "lightSuccess": "#4E7A3C",
    "lightWarning": "#9A6E15",
    "lightDanger": "#A83B24"
  },
  "theme": {
    "primary": { "dark": "darkSteel", "light": "lightSteel" },
    "secondary": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "accent": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "error": { "dark": "darkDanger", "light": "lightDanger" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkSteel", "light": "lightSteel" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkSurface", "light": "lightSurface" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },

    "diffAdded": { "dark": "darkSuccess", "light": "lightSuccess" },
    "diffRemoved": { "dark": "darkDanger", "light": "lightDanger" },
    "diffContext": { "dark": "darkFaint", "light": "lightFaint" },
    "diffHunkHeader": { "dark": "darkFaint", "light": "lightFaint" },
    "diffHighlightAdded": { "dark": "#96C083", "light": "#3E6B2F" },
    "diffHighlightRemoved": { "dark": "#D96B52", "light": "#C2472E" },
    "diffAddedBg": { "dark": "#16221A", "light": "#DDEAD7" },
    "diffRemovedBg": { "dark": "#241518", "light": "#F1DAD4" },
    "diffContextBg": { "dark": "darkSurface", "light": "lightSurface" },
    "diffLineNumber": { "dark": "darkFaint", "light": "lightFaint" },
    "diffAddedLineNumberBg": { "dark": "#12291B", "light": "#CFE0C9" },
    "diffRemovedLineNumberBg": { "dark": "#2A1216", "light": "#ECCFC9" },

    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkSteel", "light": "lightSteel" },
    "markdownLink": { "dark": "darkSteel", "light": "lightSteel" },
    "markdownLinkText": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "markdownCode": { "dark": "darkSuccess", "light": "lightSuccess" },
    "markdownBlockQuote": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownEmph": { "dark": "darkText", "light": "lightText" },
    "markdownStrong": { "dark": "darkSteel", "light": "lightSteel" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkSteel", "light": "lightSteel" },
    "markdownListEnumeration": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "markdownImage": { "dark": "darkSteel", "light": "lightSteel" },
    "markdownImageText": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },

    "syntaxComment": { "dark": "darkFaint", "light": "lightFaint" },
    "syntaxKeyword": { "dark": "darkSteel", "light": "lightSteel" },
    "syntaxFunction": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "darkSuccess", "light": "lightSuccess" },
    "syntaxNumber": { "dark": "darkWarning", "light": "lightWarning" },
    "syntaxType": { "dark": "darkSteelStrong", "light": "lightSteelStrong" },
    "syntaxOperator": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "syntaxPunctuation": { "dark": "darkTextMuted", "light": "lightTextMuted" }
  }
}
